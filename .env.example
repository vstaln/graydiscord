# copy to .env and fill in
DISCORD_TOKEN=put_bot_token_here
CLIENT_ID=put_app_client_id_here
GUILD_ID=put_dev_guild_id_here

# starboard
STARBOARD_CHANNEL_ID=
STARBOARD_THRESHOLD=3

# leveling
XP_PER_MESSAGE_MIN=10
XP_PER_MESSAGE_MAX=20
XP_COOLDOWN_SEC=120

# streams (single-creator mode; comma-separated for multi)
TWITCH_CHANNEL=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=
STREAM_ALERT_CHANNEL_ID=
STREAM_POLL_SEC=120

# github feed (polling works from home; webhook optional)
PORT=3000
GITHUB_WEBHOOK_SECRET=change_me
GITHUB_ALERT_CHANNEL_ID=
GITHUB_USER=
GITHUB_POLL_SEC=300
